{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,.next/**,out/**,app/**,components/**,lib/**,public/**,tests/**,docs/**,specs/**,notes/**,scripts/**,datagen/**,.specify/**,.claude/**,.github/**,.streamlit/**,**/__pycache__/**}"
    }
  }
}
